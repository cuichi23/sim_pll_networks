# -*- coding: utf-8 -*-
"""Local mesoscale field coupling for lattices of delay-coupled oscillators.

This module adds a *spatially resolved* field to ``sim_pll``. Every order parameter
previously available in :mod:`sim_pll.evaluation_lib` is a global projection of the
phase configuration onto a fixed pattern template (m-twist, chequerboard). None of
them is local, so none of them can represent a mesoscale field that varies across
the lattice.

Motivation
----------
In cortex the extracellular field is generated by transmembrane return currents
flowing through a resistive medium. Because current dipoles superpose linearly and
the medium is quasi-static, the measured field at a point is a distance-weighted
sum over the surrounding population. Its amplitude therefore scales as ``sqrt(N)``
for mutually independent sources and as ``N`` for synchronised ones: the field is,
up to the spatial kernel, a coherence measure.

The local Kuramoto order parameter has exactly this scaling, which makes it the
natural phase-oscillator analogue of the local field potential

.. math::
	Z_i(t) = \\sum_j W(|r_i - r_j|)\\, e^{i \\theta_j(t)} \\Big/ \\sum_j W(|r_i - r_j|)

with :math:`Z_i = R_i e^{i \\Psi_i}`. The *unnormalised* sum is the field proxy,
because normalising divides out precisely the amplitude information that makes a
local field potential an amplitude. Both are provided.

The two channels
----------------
The point of the module is to let the field act back on the oscillators, and to
make the strength of that action an explicit control parameter. Each oscillator
then obeys

.. math::
	\\dot{\\theta_i} = \\omega_i
		+ K\\, u_i(t)
		+ \\varepsilon K\\, R_i(t) \\sin(\\Psi_i(t) - \\theta_i(t))

where :math:`u_i` is the loop-filtered, transmission-delayed synaptic drive that
``sim_pll`` already computes, and the second term is the field channel. The field
channel carries **no delay** and is **not** passed through the loop filter, which
is what distinguishes it physically: synaptic coupling is delayed and dendritically
integrated, field coupling is quasi-instantaneous and acts directly on the membrane.

``epsilon`` is dimensionless and is the ratio of field to synaptic coupling. At
``epsilon = 0`` the field is a pure diagnostic and the dynamics are bit-identical to
:func:`sim_pll.sim_lib.simulate_headless`; this is asserted by a regression test.

Notes
-----
Nothing in :mod:`sim_pll.pll_lib` or :mod:`sim_pll.sim_lib` is modified. The driver
below replicates the update chain of :meth:`sim_pll.pll_lib.PhaseLockedLoop.next`
and injects the field term into the signal-controlled oscillator.

Index convention follows :mod:`sim_pll.evaluation_lib`: oscillator ``k`` sits at
row ``y = k // nx`` and column ``x = k % nx``, matching ``np.reshape(phi, (ny, nx))``.
"""

from typing import Optional, Tuple

import numpy as np

from sim_pll import check_dicts_lib as chk_dicts
from sim_pll import sim_lib


KERNEL_KINDS = ('dipole', 'gaussian', 'exponential', 'nearest')


# ##############################################################################
# geometry and kernels
# ##############################################################################

def lattice_positions(nx: int, ny: int) -> np.ndarray:
	"""Cartesian positions of the oscillators on a rectangular lattice.

	Args:
		nx: number of lattice columns
		ny: number of lattice rows

	Returns:
		array of shape ``(nx * ny, 2)`` holding the ``(x, y)`` position of each
		oscillator in lattice units, ordered so that index ``k`` has
		``x = k % nx`` and ``y = k // nx``
	"""
	indices = np.arange(nx * ny)
	return np.stack([indices % nx, indices // nx], axis=1).astype(float)


def pairwise_distances(nx: int, ny: int, periodic: bool = True) -> np.ndarray:
	"""Euclidean distance matrix of a rectangular lattice.

	Args:
		nx: number of lattice columns
		ny: number of lattice rows
		periodic: if True use the minimum-image convention, i.e. a torus, which
			removes boundary artefacts from the field; if False use open boundaries

	Returns:
		symmetric array of shape ``(nx * ny, nx * ny)`` with zero diagonal
	"""
	positions = lattice_positions(nx, ny)
	delta = positions[:, None, :] - positions[None, :, :]
	if periodic:
		extent = np.array([nx, ny], dtype=float)
		delta -= extent * np.round(delta / extent)
	return np.sqrt(np.sum(delta ** 2, axis=2))


def build_kernel(nx: int, ny: int, kind: str = 'dipole', sigma: float = 2.0,
				 periodic: bool = True, include_self: bool = True,
				 normalize_rows: bool = True, cutoff_radius: Optional[float] = None) -> np.ndarray:
	"""Spatial weighting kernel that defines what 'local' means for the field.

	The ``dipole`` kernel falls off as :math:`1/(1 + (r/\\sigma)^2)`, which is the
	regularised form of the :math:`1/r^2` decay of a current-dipole potential. It is
	the physically motivated default: cortical field generation is dominated by
	dipolar sources formed by synaptic sinks on apical dendrites and their somatic
	return currents. The other kernels are provided for robustness checks.

	Args:
		nx: number of lattice columns
		ny: number of lattice rows
		kind: one of ``'dipole'``, ``'gaussian'``, ``'exponential'``, ``'nearest'``
		sigma: kernel length scale in lattice units; ignored for ``'nearest'``
		periodic: use the minimum-image convention for distances
		include_self: whether an oscillator contributes to its own local field;
			cortically it does, since a neuron sits inside the field it helps create
		normalize_rows: divide each row by its sum, giving the normalised order
			parameter with ``R_i`` in ``[0, 1]``; set False for the unnormalised
			field proxy
		cutoff_radius: if given, weights beyond this distance are set to zero

	Returns:
		array of shape ``(nx * ny, nx * ny)`` of non-negative weights

	Raises:
		ValueError: if ``kind`` is not a recognised kernel or ``sigma`` is not positive
	"""
	if kind not in KERNEL_KINDS:
		raise ValueError('unknown kernel kind %r, expected one of %s' % (kind, KERNEL_KINDS))
	if sigma <= 0.0:
		raise ValueError('sigma must be positive, got %r' % (sigma,))

	distances = pairwise_distances(nx, ny, periodic=periodic)

	if kind == 'dipole':
		weights = 1.0 / (1.0 + (distances / sigma) ** 2)
	elif kind == 'gaussian':
		weights = np.exp(-0.5 * (distances / sigma) ** 2)
	elif kind == 'exponential':
		weights = np.exp(-distances / sigma)
	else:															# 'nearest'
		weights = (distances <= 1.0 + 1e-9).astype(float)

	if cutoff_radius is not None:
		weights = np.where(distances <= cutoff_radius, weights, 0.0)

	if not include_self:
		np.fill_diagonal(weights, 0.0)

	if normalize_rows:
		row_sums = weights.sum(axis=1, keepdims=True)
		if np.any(row_sums <= 0.0):
			raise ValueError('kernel has an all-zero row; widen sigma or the cutoff radius')
		weights = weights / row_sums

	return weights


def lattice_adjacency(nx: int, ny: int, periodic: bool = True, radius: float = 1.0) -> np.ndarray:
	"""Binary adjacency matrix of a rectangular lattice, for the synaptic channel.

	This defines who is wired to whom, which is a separate question from the spatial
	kernel of the field: synaptic coupling is sparse and explicit, field coupling is
	dense and geometric. Keeping the two independent is the point of the model.

	Args:
		nx: number of lattice columns
		ny: number of lattice rows
		periodic: wrap the lattice onto a torus
		radius: couple all oscillators within this distance; 1.0 gives the four
			nearest neighbours on a square lattice

	Returns:
		binary array of shape ``(nx * ny, nx * ny)`` with a zero diagonal, where
		entry ``[k, l]`` means oscillator ``k`` receives the signal of oscillator ``l``
	"""
	distances = pairwise_distances(nx, ny, periodic=periodic)
	adjacency = ((distances > 0.0) & (distances <= radius + 1e-9)).astype(float)
	return adjacency


# ##############################################################################
# the field itself
# ##############################################################################

def local_order_parameter(phi: np.ndarray, kernel: np.ndarray) -> np.ndarray:
	"""Complex local Kuramoto order parameter of a phase configuration.

	Args:
		phi: phases, either shape ``(N,)`` for a single time or ``(T, N)`` for a
			time series
		kernel: weighting matrix of shape ``(M, N)`` from :func:`build_kernel`, normally
			square with ``M = N``; a rectangular kernel is allowed and gives an
			aggregate readout over ``M`` observation points, for example a single
			row that sums the whole population

	Returns:
		complex array with trailing dimension ``M``; ``abs`` gives the local
		coherence ``R_i`` and ``angle`` gives the local mean phase ``Psi_i``

	Raises:
		ValueError: if the trailing dimension of ``phi`` does not match the number of
			kernel columns
	"""
	phi = np.asarray(phi)
	kernel = np.asarray(kernel)
	if phi.shape[-1] != kernel.shape[1]:
		raise ValueError('phi has %d oscillators but kernel expects %d sources'
						 % (phi.shape[-1], kernel.shape[1]))
	return np.exp(1j * phi) @ kernel.T


def local_field(phi: np.ndarray, kernel: np.ndarray, amplitudes: Optional[np.ndarray] = None) -> np.ndarray:
	"""Real-valued field proxy, the analogue of a local field potential.

	This is the *unnormalised* weighted sum, so it retains the amplitude scaling that
	distinguishes a coherent population from an incoherent one. Pass a kernel built
	with ``normalize_rows=False``.

	Args:
		phi: phases of shape ``(N,)`` or ``(T, N)``
		kernel: weighting matrix of shape ``(N, N)``
		amplitudes: optional per-oscillator source amplitudes of shape ``(N,)``;
			defaults to unity, which is the phase-only limit

	Returns:
		real array of the same leading shape as ``phi``
	"""
	phi = np.asarray(phi)
	source = np.exp(1j * phi) if amplitudes is None else amplitudes * np.exp(1j * phi)
	return np.real(source @ kernel.T)


def coherence_statistics(phi: np.ndarray, kernel: np.ndarray) -> dict:
	"""Summary statistics of the local coherence field over space and time.

	The spatial standard deviation of ``R_i`` is the quantity that separates a
	chimera-like state, in which coherent and incoherent domains coexist, from a
	spatially uniform one. A globally synchronised state and a globally incoherent
	state both have low spatial spread; only coexistence gives a high one.

	Args:
		phi: phases of shape ``(T, N)``
		kernel: normalised weighting matrix of shape ``(N, N)``

	Returns:
		dict with keys ``'r_local'`` (shape ``(T, N)``), ``'r_mean'``, ``'r_spatial_std'``
		(both shape ``(T,)``), ``'r_global'`` (shape ``(T,)``), and the time-averaged
		scalars ``'mean_r_local'``, ``'mean_spatial_std'``, ``'mean_r_global'``
	"""
	phi = np.atleast_2d(np.asarray(phi))
	r_local = np.abs(local_order_parameter(phi, kernel))
	r_global = np.abs(np.mean(np.exp(1j * phi), axis=1))
	r_spatial_std = np.std(r_local, axis=1)
	return {
		'r_local': r_local,
		'r_mean': np.mean(r_local, axis=1),
		'r_spatial_std': r_spatial_std,
		'r_global': r_global,
		'mean_r_local': float(np.mean(r_local)),
		'mean_spatial_std': float(np.mean(r_spatial_std)),
		'mean_r_global': float(np.mean(r_global)),
	}


def spatial_correlation_length(phi_row: np.ndarray, nx: int, ny: int, periodic: bool = True) -> float:
	"""Correlation length of the phase pattern at one instant, in lattice units.

	Computes the pairwise phase coherence ``|<exp(i(theta_i - theta_j))>|`` binned by
	separation and returns the distance at which it first falls below ``1/e``. This
	distinguishes a locally ordered pattern from a globally ordered one.

	Args:
		phi_row: phases at a single time, shape ``(N,)``
		nx: number of lattice columns
		ny: number of lattice rows
		periodic: use the minimum-image convention

	Returns:
		correlation length in lattice units; ``np.nan`` if coherence never decays
		below ``1/e`` within the lattice
	"""
	distances = pairwise_distances(nx, ny, periodic=periodic)
	phase_diff = np.exp(1j * (phi_row[:, None] - phi_row[None, :]))
	max_separation = int(np.floor(distances.max()))
	separations = np.arange(1, max_separation + 1)
	coherence = np.empty(separations.shape, dtype=float)
	for index, separation in enumerate(separations):
		mask = (distances > separation - 0.5) & (distances <= separation + 0.5)
		coherence[index] = np.abs(np.mean(phase_diff[mask])) if np.any(mask) else np.nan

	below = np.where(coherence < np.exp(-1.0))[0]
	return float(separations[below[0]]) if below.size > 0 else float('nan')


def pattern_order_parameters(phi_row: np.ndarray, nx: int, ny: int) -> dict:
	"""Projections of a phase configuration onto the standard lattice attractors.

	A periodic lattice of delay-coupled oscillators is multistable. Besides the in-phase
	state it supports m-twist states, in which the phase winds by an integer number of
	turns across the lattice, and the chequerboard state, in which neighbours are in
	antiphase. All three are frequency locked, so a frequency-spread criterion alone
	cannot tell them apart, and the global coherence of a twist or chequerboard state is
	near zero even though the state is perfectly ordered.

	Args:
		phi_row: phases at a single time, shape ``(N,)`` with ``N = nx * ny``
		nx: number of lattice columns
		ny: number of lattice rows

	Returns:
		dict with ``'in_phase'`` (the usual global coherence), ``'chequerboard'``,
		``'twist_max'`` (the largest twist projection over non-zero winding numbers),
		``'twist_mx'`` and ``'twist_my'`` (the winding numbers attaining it), and
		``'state'``, a label in ``{'in-phase', 'twist', 'chequerboard', 'unordered'}``
	"""
	phi_row = np.asarray(phi_row)
	positions = lattice_positions(nx, ny)
	x, y = positions[:, 0], positions[:, 1]
	phasor = np.exp(1j * phi_row)

	in_phase = float(np.abs(np.mean(phasor)))
	chequerboard = float(np.abs(np.mean(phasor * (-1.0) ** (x + y))))

	twist_max, best = 0.0, (0, 0)
	for mx in range(nx):
		for my in range(ny):
			if mx == 0 and my == 0:
				continue
			projection = float(np.abs(np.mean(
				phasor * np.exp(-2j * np.pi * (mx * x / nx + my * y / ny)))))
			if projection > twist_max:
				twist_max, best = projection, (mx, my)

	scores = {'in-phase': in_phase, 'chequerboard': chequerboard, 'twist': twist_max}
	label = max(scores, key=scores.get)
	if scores[label] < 0.5:
		label = 'unordered'

	return {'in_phase': in_phase, 'chequerboard': chequerboard, 'twist_max': twist_max,
			'twist_mx': best[0], 'twist_my': best[1], 'state': label}


def random_phase_baseline(nx: int, ny: int, kernel: np.ndarray, realizations: int = 400,
						  seed: int = 0) -> dict:
	"""Null distribution of the local coherence for uniformly random phases.

	The spatial spread of :math:`R_k` has a large, kernel-dependent baseline that must be
	subtracted before any claim of spatial structure. Because neighbouring kernels
	overlap, the values of :math:`R_k` across the lattice are spatially correlated, and
	the marginal Rayleigh formula overestimates the spatial standard deviation. The
	baseline is therefore measured rather than derived.

	Args:
		nx: number of lattice columns
		ny: number of lattice rows
		kernel: normalised weighting matrix of shape ``(N, N)``
		realizations: number of random phase configurations to average over
		seed: seed for the random phases

	Returns:
		dict with ``'mean_r_local'``, ``'spatial_std'``, ``'participation_number'``
	"""
	rng = np.random.default_rng(seed)
	number_of_oscillators = nx * ny
	means, spreads = [], []
	for _ in range(realizations):
		r_local = np.abs(local_order_parameter(
			rng.uniform(0.0, 2.0 * np.pi, number_of_oscillators), kernel))
		means.append(np.mean(r_local))
		spreads.append(np.std(r_local))
	return {'mean_r_local': float(np.mean(means)),
			'spatial_std': float(np.mean(spreads)),
			'participation_number': float(participation_number(kernel))}


def site_permutation_baseline(phases: np.ndarray, kernel: np.ndarray,
							  realizations: int = 200, seed: int = 0) -> dict:
	"""Null obtained by shuffling a measured phase configuration across lattice sites.

	The random-phase baseline of :func:`random_phase_baseline` tests whether a state is
	distinguishable from complete disorder, which is not the question when the state is
	already partially ordered: a partially ordered lattice exceeds that null merely by
	being ordered. Permuting the measured phases across sites preserves the phase
	distribution exactly, and therefore the degree of order and the mean local coherence,
	while destroying the spatial arrangement. The excess of the measured spatial spread
	over this surrogate is what isolates spatial structure.

	Args:
		phases: measured phases, shape ``(N,)`` for one instant or ``(T, N)``; a time
			series is reduced by treating each row as an independent configuration
		kernel: row-normalised weighting matrix of shape ``(N, N)``
		realizations: number of permutations per configuration
		seed: seed for the permutations

	Returns:
		dict with ``'spatial_std'`` and ``'mean_r_local'`` of the surrogate ensemble, and
		``'measured_spatial_std'`` and ``'measured_mean_r_local'`` of the input
	"""
	phases = np.atleast_2d(np.asarray(phases))
	rng = np.random.default_rng(seed)

	measured = np.abs(local_order_parameter(phases, kernel))
	surrogate_spread, surrogate_mean = [], []
	for row in phases:
		for _ in range(max(1, realizations // len(phases))):
			shuffled = np.abs(local_order_parameter(rng.permutation(row), kernel))
			surrogate_spread.append(np.std(shuffled))
			surrogate_mean.append(np.mean(shuffled))

	return {'spatial_std': float(np.mean(surrogate_spread)),
			'mean_r_local': float(np.mean(surrogate_mean)),
			'measured_spatial_std': float(np.mean(np.std(measured, axis=1))),
			'measured_mean_r_local': float(np.mean(measured))}


def participation_number(kernel: np.ndarray) -> float:
	r"""Effective number of oscillators contributing to one local field value.

	Defined as :math:`1/\sum_l W_{kl}^2` for a row-normalised kernel. This is the honest
	measure of how local the field channel is, and it is not set by sigma alone: in two
	dimensions a kernel with a :math:`1/d^2` tail has logarithmically divergent mass, so
	its participation number grows with the lattice rather than saturating.

	Args:
		kernel: row-normalised weighting matrix of shape ``(N, N)``

	Returns:
		participation number of the first row
	"""
	return float(1.0 / np.sum(np.asarray(kernel)[0] ** 2))


def fourier_symbol(kernel: np.ndarray, nx: int, ny: int, qx: int, qy: int) -> float:
	"""Fourier symbol of a translation-invariant lattice kernel at one wavevector.

	Args:
		kernel: row-normalised matrix of shape ``(N, N)``, translation invariant on the torus
		nx: lattice columns
		ny: lattice rows
		qx: integer wavenumber along x, in ``0 .. nx-1``
		qy: integer wavenumber along y, in ``0 .. ny-1``

	Returns:
		the real part of :math:`\hat{K}(q) = \sum_l K_{0l} e^{i q \cdot r_l}`
	"""
	positions = lattice_positions(nx, ny)
	phase = np.exp(2j * np.pi * (qx * positions[:, 0] / nx + qy * positions[:, 1] / ny))
	return float(np.real(np.sum(np.asarray(kernel)[0] * phase)))


def in_phase_collective_frequency(intrinsic_freq_hz: float, coupling_hz: float,
								  delay_s: float, coupling_function=np.sin) -> float:
	r"""Self-consistent collective frequency of the in-phase state.

	In the in-phase state every phase difference vanishes, so the field term of
	Eq. (1) is identically zero and the collective frequency is independent of the field
	gain. It solves

	.. math::
		f_\Omega = f_0 + K\, h(-2\pi f_\Omega 	au).

	This is the frequency at which the stability criterion must be evaluated. Using the
	frequency measured in a simulation instead is wrong whenever the system has left the
	in-phase state, which beyond the boundary it has: there the measured value belongs to
	the chequerboard branch or to a drifting state.

	Args:
		intrinsic_freq_hz: mean intrinsic frequency
		coupling_hz: coupling strength K in Hz
		delay_s: transmission delay in seconds
		coupling_function: the coupling function h

	Returns:
		the in-phase collective frequency in Hz

	Raises:
		ValueError: if no root is bracketed in ``f0 +/- K``
	"""
	def residual(frequency):
		return frequency - intrinsic_freq_hz - coupling_hz * coupling_function(
			-2.0 * np.pi * frequency * delay_s)

	low, high = intrinsic_freq_hz - 2.0 * coupling_hz, intrinsic_freq_hz + 2.0 * coupling_hz
	if residual(low) * residual(high) > 0:
		raise ValueError('no in-phase branch bracketed for tau = %g' % delay_s)
	for _ in range(200):
		mid = 0.5 * (low + high)
		if residual(low) * residual(mid) <= 0:
			high = mid
		else:
			low = mid
	return 0.5 * (low + high)


def in_phase_stability_threshold(nx: int, ny: int, field_kernel: np.ndarray,
								 adjacency_kernel: np.ndarray,
								 collective_frequency_hz: float, delay_s: float) -> dict:
	r"""Field coupling needed to stabilise the in-phase state against the delayed channel.

	Linearising Eqs. (1)-(2) about the in-phase state and transforming to lattice modes, the
	growth rate of mode :math:`q` is governed by

	.. math::
		\varepsilon\,[1 - \hat{W}(q)] + \cos(\Omega\tau)\,[1 - \hat{c}(q)] > 0,

	where :math:`\hat{W}` and :math:`\hat{c}` are the Fourier symbols of the field kernel and the
	normalised adjacency. The loop-filter cutoff cancels at zero growth rate, so it sets how fast
	a perturbation decays but not whether it does. For delays beyond a quarter cycle
	:math:`\cos(\Omega\tau)` is negative and the delayed channel destabilises the modes for which
	:math:`\hat{c}(q) < 1`; the field channel must supply enough restoring torque to compensate.

	On a square lattice with nearest-neighbour coupling the binding mode is the chequerboard
	:math:`q = (\pi, \pi)`, where :math:`\hat{c} = -1` exactly and a smooth field kernel has
	:math:`\hat{W} \approx 0`, giving :math:`\varepsilon_c \approx -2\cos(\Omega\tau)`.

	Args:
		nx: lattice columns
		ny: lattice rows
		field_kernel: row-normalised field kernel of shape ``(N, N)``
		adjacency_kernel: row-normalised adjacency of shape ``(N, N)``
		collective_frequency_hz: the locked collective frequency :math:`\Omega/2\pi`
		delay_s: transmission delay in seconds

	Returns:
		dict with ``'epsilon_c'``, the binding mode ``'mode'``, and ``'cos_omega_tau'``
	"""
	cos_omega_tau = float(np.cos(2.0 * np.pi * collective_frequency_hz * delay_s))
	threshold, binding = 0.0, (0, 0)
	for qx in range(nx):
		for qy in range(ny):
			if qx == 0 and qy == 0:
				continue
			restoring = 1.0 - fourier_symbol(field_kernel, nx, ny, qx, qy)
			delayed = cos_omega_tau * (1.0 - fourier_symbol(adjacency_kernel, nx, ny, qx, qy))
			if restoring > 1e-9 and delayed < 0.0:
				required = -delayed / restoring
				if required > threshold:
					threshold, binding = required, (qx, qy)
	return {'epsilon_c': threshold, 'mode': binding, 'cos_omega_tau': cos_omega_tau}


class LocalFieldCoupling:
	"""The instantaneous mesoscale field channel acting on a lattice of oscillators.

	Holds the spatial kernel and the coupling strength, and turns a phase
	configuration into the additive drive each oscillator receives from its local
	field. Two modes are supported.

	``'additive'``
		The field pulls each oscillator toward the local mean phase with a strength
		set by the local coherence, ``R_i sin(Psi_i - theta_i)``. This is the local
		analogue of Kuramoto mean-field coupling and the model of ephaptic coupling.

	``'gating'``
		The field multiplicatively scales the synaptic drive rather than adding to
		it, reproducing the alpha-gates-gamma motif in which a slow rhythm brakes a
		fast one. The gate is ``1 - depth * R_i``, so a locally coherent slow field
		suppresses the fast channel where it is strong.

	Attributes:
		kernel: normalised weighting matrix of shape ``(N, N)``
		epsilon: dimensionless field coupling strength relative to the synaptic
			coupling K
		mode: ``'additive'`` or ``'gating'``
		gate_depth: depth of the multiplicative gate, only used in ``'gating'`` mode
	"""

	def __init__(self, kernel: np.ndarray, epsilon: float, mode: str = 'additive',
				 gate_depth: float = 1.0) -> None:
		"""
		Args:
			kernel: weighting matrix of shape ``(N, N)``, normally row-normalised
			epsilon: field coupling strength relative to K; zero disables the channel
			mode: ``'additive'`` for ephaptic pull, ``'gating'`` for multiplicative gating
			gate_depth: gate depth in ``'gating'`` mode, where 1.0 gives full suppression
				at unit local coherence

		Raises:
			ValueError: if the kernel is not square or the mode is unrecognised
		"""
		kernel = np.asarray(kernel, dtype=float)
		if kernel.ndim != 2 or kernel.shape[0] != kernel.shape[1]:
			raise ValueError('kernel must be a square matrix, got shape %s' % (kernel.shape,))
		if mode not in ('additive', 'gating'):
			raise ValueError("mode must be 'additive' or 'gating', got %r" % (mode,))

		self.kernel = kernel
		self.epsilon = float(epsilon)
		self.mode = mode
		self.gate_depth = float(gate_depth)

	@property
	def is_active(self) -> bool:
		"""Whether the channel exerts any influence on the dynamics."""
		return self.epsilon != 0.0

	def order_parameter(self, phi_row: np.ndarray) -> np.ndarray:
		"""Complex local order parameter of one phase configuration.

		Args:
			phi_row: phases at a single time, shape ``(N,)``

		Returns:
			complex array of shape ``(N,)``
		"""
		return local_order_parameter(phi_row, self.kernel)

	def drive(self, phi_row: np.ndarray) -> np.ndarray:
		"""Additive drive contributed by the local field, in units of the control signal.

		Args:
			phi_row: phases at a single time, shape ``(N,)``

		Returns:
			real array of shape ``(N,)``; identically zero for ``'gating'`` mode,
			whose influence is applied through :meth:`gate` instead
		"""
		if self.mode != 'additive' or not self.is_active:
			return np.zeros(self.kernel.shape[0])
		z = self.order_parameter(phi_row)
		return self.epsilon * np.imag(z * np.exp(-1j * np.asarray(phi_row)))

	def gate(self, phi_row: np.ndarray) -> np.ndarray:
		"""Multiplicative gate applied to the synaptic drive.

		Args:
			phi_row: phases at a single time, shape ``(N,)``

		Returns:
			real array of shape ``(N,)``; identically one when gating is inactive
		"""
		if self.mode != 'gating' or not self.is_active:
			return np.ones(self.kernel.shape[0])
		r_local = np.abs(self.order_parameter(phi_row))
		return 1.0 - self.gate_depth * self.epsilon * r_local


