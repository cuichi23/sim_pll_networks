def _step_oscillator(pll, index_current_time: int, phase_array_len: int, phi: np.ndarray,
					 field_drive: float, synaptic_gate: float) -> np.floating:
	"""Advance one oscillator by a single step with the field channel included.

	Replicates :meth:`sim_pll.pll_lib.PhaseLockedLoop.next` and adds the field term
	directly to the signal-controlled oscillator, so the field bypasses the loop
	filter and carries no delay.

	Args:
		pll: a :class:`sim_pll.pll_lib.PhaseLockedLoop` instance
		index_current_time: absolute time index within the simulation
		phase_array_len: length of the cyclic phase memory
		phi: cyclic phase memory of shape ``(phase_array_len, N)``
		field_drive: additive contribution of the local field for this oscillator
		synaptic_gate: multiplicative factor applied to the loop-filtered drive

	Returns:
		the updated phase of this oscillator
	"""
	feedback_delayed_phases, transmission_delayed_phases = pll.delayer.next(
		index_current_time % phase_array_len, phi, index_current_time)
	phase_detector_output = pll.phase_detector_combiner.next(
		feedback_delayed_phases, transmission_delayed_phases, 0, index_current_time)
	control_signal = pll.low_pass_filter.next(phase_detector_output)
	return pll.signal_controlled_oscillator.next(synaptic_gate * control_signal + field_drive)[0]


def simulate_two_band_gating(dict_net: dict, dict_pll: dict, dict_algo: dict,
							 kernel: np.ndarray, gate_depth: float,
							 number_per_band: int, seed: Optional[int] = None,
							 store_fields: bool = True) -> dict:
	r"""Two frequency bands on one lattice, the slow band gating the fast band.

	This is the multiplicative, cross-frequency arrangement that the additive channel of
	:func:`simulate_with_local_field` does not represent. Two populations occupy the same
	lattice sites. Each has its own delayed nearest-neighbour coupling and its own
	intrinsic frequency; there is no synaptic connection between them. The only coupling
	between bands is the gate: the local coherence of the slow band multiplies the
	coupling gain of the co-located fast oscillator,

	.. math::
		g_k(t) = 1 - \mathrm{depth} \cdot R^{\rm slow}_k(t),

	so the fast band is suppressed where the slow band is locally coherent and expressed
	where it is not. Unlike additive phase attraction, this can silence a region, which
	is what makes it a model of routing rather than of timing.

	The oscillator list is expected to hold the slow band first, then the fast band, so
	oscillator ``k`` and oscillator ``k + number_per_band`` share a lattice site.

	Args:
		dict_net: network configuration for the combined ``2 * number_per_band`` network
		dict_pll: oscillator configuration, with intrinsic frequencies set per band
		dict_algo: algorithm configuration
		kernel: row-normalised kernel of shape ``(number_per_band, number_per_band)``
			acting within the slow band
		gate_depth: depth of the multiplicative gate; zero disables gating and leaves two
			independent bands, one is full suppression at unit local coherence
		number_per_band: number of oscillators in each band
		seed: seed for numpy's random number generator
		store_fields: record the slow-band coherence and the gate

	Returns:
		dict with the usual four keys; ``dict_data`` additionally carries ``'gate'`` and
		``'r_slow'``, both of shape ``(steps, number_per_band)``

	Raises:
		ValueError: if the kernel size does not match ``number_per_band``, or the network
			does not hold exactly two bands of that size
	"""
	if kernel.shape[0] != number_per_band:
		raise ValueError('kernel is sized for %d oscillators but a band holds %d'
						 % (kernel.shape[0], number_per_band))
	total = dict_net['Nx'] * dict_net['Ny']
	if total != 2 * number_per_band:
		raise ValueError('network holds %d oscillators, expected %d for two bands'
						 % (total, 2 * number_per_band))

	np.random.seed(seed)
	dict_pll, dict_net, dict_algo = chk_dicts.check_dicts_consistency(dict_pll, dict_net, dict_algo)
	dict_data, pll_list = sim_lib.prepare_simulation(dict_net, dict_pll, dict_algo)

	phi = dict_data['phi']
	phase_array_len = dict_net['phi_array_len']
	max_delay_steps = dict_net['max_delay_steps']
	total_steps = max_delay_steps + dict_pll['sim_time_steps']

	phi_store = np.empty([total_steps, total])
	phi_store[0:max_delay_steps + 1, :] = phi[0:max_delay_steps + 1, :]
	gate_store = np.ones([total_steps, number_per_band]) if store_fields else None
	slow_store = np.zeros([total_steps, number_per_band]) if store_fields else None

	no_drive = 0.0
	for index_current_time in range(max_delay_steps, total_steps - 1, 1):
		phi_now = phi[index_current_time % phase_array_len, :]
		r_slow = np.abs(local_order_parameter(phi_now[:number_per_band], kernel))
		gate = 1.0 - gate_depth * r_slow

		if store_fields:
			slow_store[index_current_time, :] = r_slow
			gate_store[index_current_time, :] = gate

		updated = []
		for pll in pll_list:
			is_fast = pll.pll_id >= number_per_band
			factor = gate[pll.pll_id - number_per_band] if is_fast else 1.0
			updated.append(_step_oscillator(pll, index_current_time, phase_array_len, phi,
											no_drive, factor))
		phi[(index_current_time + 1) % phase_array_len, :] = updated
		phi_store[index_current_time + 1, :] = phi[(index_current_time + 1) % phase_array_len, :]

	dict_data.pop('clock_counter', None)
	dict_data.update({'t': np.arange(0, total_steps) * dict_pll['dt'], 'phi': phi_store})
	if store_fields:
		gate_store[total_steps - 1, :] = gate_store[total_steps - 2, :]
		slow_store[total_steps - 1, :] = slow_store[total_steps - 2, :]
		dict_data.update({'gate': gate_store, 'r_slow': slow_store,
						  'number_per_band': number_per_band, 'gate_depth': gate_depth})

	return {'dict_net': dict_net, 'dict_pll': dict_pll, 'dict_algo': dict_algo, 'dict_data': dict_data}


def simulate_with_local_field(dict_net: dict, dict_pll: dict, dict_algo: dict,
							  field_coupling: Optional[LocalFieldCoupling] = None,
							  seed: Optional[int] = None,
							  store_field: bool = True,
							  diagnostic_kernel: Optional[np.ndarray] = None) -> dict:
	"""Run a simulation in which a local mesoscale field acts back on the oscillators.

	The synaptic channel is unchanged: transmission-delayed phase comparison through
	the loop filter, exactly as in :func:`sim_pll.sim_lib.simulate_headless`. The
	field channel is added on top, without delay and without loop filtering.

	Passing ``field_coupling=None`` or a coupling with ``epsilon = 0`` leaves the
	dynamics bit-identical to :func:`sim_pll.sim_lib.simulate_headless` for the same
	seed, while still recording the field as a diagnostic. That is the open-loop
	control condition: the field reports but does not act.

	Args:
		dict_net: network configuration; see :func:`sim_pll.dicts_factory.generate_dicts`
		dict_pll: oscillator configuration
		dict_algo: algorithm configuration
		field_coupling: the field channel; ``None`` means no feedback
		seed: seed for numpy's random number generator, for reproducible noise
		store_field: whether to record the local order parameter time series
		diagnostic_kernel: kernel used for recording only; defaults to the kernel of
			``field_coupling``, or a dipole kernel with ``sigma = 2`` if that is absent

	Returns:
		dict with keys ``'dict_net'``, ``'dict_pll'``, ``'dict_algo'`` and ``'dict_data'``.
		``dict_data`` carries the phase array ``'phi'`` of shape
		``(max_delay_steps + sim_time_steps, N)``, the time vector ``'t'``, and, when
		``store_field`` is set, the complex local order parameter ``'z_local'`` of the
		same shape together with ``'r_local'`` and ``'epsilon'``

	Raises:
		ValueError: if the kernel size does not match the number of oscillators
	"""
	np.random.seed(seed)
	dict_pll, dict_net, dict_algo = chk_dicts.check_dicts_consistency(dict_pll, dict_net, dict_algo)
	dict_data, pll_list = sim_lib.prepare_simulation(dict_net, dict_pll, dict_algo)

	number_of_oscillators = dict_net['Nx'] * dict_net['Ny']
	if field_coupling is not None and field_coupling.kernel.shape[0] != number_of_oscillators:
		raise ValueError('kernel is sized for %d oscillators but the network has %d'
						 % (field_coupling.kernel.shape[0], number_of_oscillators))

	if diagnostic_kernel is None:
		diagnostic_kernel = (field_coupling.kernel if field_coupling is not None
							 else build_kernel(dict_net['Nx'], dict_net['Ny'], sigma=2.0))

	phi = dict_data['phi']
	phase_array_len = dict_net['phi_array_len']
	max_delay_steps = dict_net['max_delay_steps']
	total_steps = max_delay_steps + dict_pll['sim_time_steps']

	phi_store = np.empty([total_steps, number_of_oscillators])
	phi_store[0:max_delay_steps + 1, :] = phi[0:max_delay_steps + 1, :]
	z_store = np.zeros([total_steps, number_of_oscillators], dtype=complex) if store_field else None

	inactive_drive = np.zeros(number_of_oscillators)
	unit_gate = np.ones(number_of_oscillators)

	for index_current_time in range(max_delay_steps, total_steps - 1, 1):
		phi_now = phi[index_current_time % phase_array_len, :]

		if field_coupling is not None:
			field_drive = field_coupling.drive(phi_now)
			synaptic_gate = field_coupling.gate(phi_now)
		else:
			field_drive = inactive_drive
			synaptic_gate = unit_gate

		if store_field:
			z_store[index_current_time, :] = local_order_parameter(phi_now, diagnostic_kernel)

		phi[(index_current_time + 1) % phase_array_len, :] = [
			_step_oscillator(pll, index_current_time, phase_array_len, phi,
							 field_drive[pll.pll_id], synaptic_gate[pll.pll_id])
			for pll in pll_list]
		phi_store[index_current_time + 1, :] = phi[(index_current_time + 1) % phase_array_len, :]

	time_vector = np.arange(0, total_steps) * dict_pll['dt']
	dict_data.pop('clock_counter', None)
	dict_data.update({'t': time_vector, 'phi': phi_store})

	if store_field:
		z_store[total_steps - 1, :] = local_order_parameter(
			phi[(total_steps - 1) % phase_array_len, :], diagnostic_kernel)
		dict_data.update({
			'z_local': z_store,
			'r_local': np.abs(z_store),
			'epsilon': field_coupling.epsilon if field_coupling is not None else 0.0,
		})

	return {'dict_net': dict_net, 'dict_pll': dict_pll, 'dict_algo': dict_algo, 'dict_data': dict_data}
